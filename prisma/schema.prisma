generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  nome      String
  bio       String?
  avatarUrl String?
  bannerUrl String?
  pontuacao Int      @default(0)
  createdAt DateTime @default(now())
}